# NPU-Assistant 运行配置示例
# 复制为 .env 后可被启动脚本读取（注意：本项目默认不自动加载 .env，
# 请在启动前通过环境变量注入，例如 PowerShell:
#   $env:NPU_ADMIN_TOKEN="your-token"; .\scripts\run.ps1
# 或在 .\scripts\run.ps1 中取消 dotenv 注释）

# 服务监听
# NPU_HOST=127.0.0.1
# NPU_PORT=8000

# 可选：管理接口令牌。设置后所有写操作需要请求头 X-Admin-Token
# NPU_ADMIN_TOKEN=

# 数据目录（默认 backend/data）
# NPU_DATA_DIR=D:\Development\NPU-Assistant\backend\data
# NPU_DB_PATH=D:\Development\NPU-Assistant\backend\data\app.db

# 首次启动是否自动导入 backend/data/seed_docs 示例文档
# NPU_AUTO_SEED=1

# 上传大小上限（MB）
# NPU_MAX_UPLOAD_MB=20
