# NPU-Assistant 运行配置示例
# 复制为 .env 后按需注入；项目默认不自动加载 .env。

# 服务监听
# NPU_HOST=127.0.0.1
# NPU_PORT=8000

# 可选：管理接口令牌。设置后所有写操作需要请求头 X-Admin-Token
# NPU_ADMIN_TOKEN=

# 数据目录（默认 backend/data）
# NPU_DATA_DIR=./backend/data
# NPU_DB_PATH=./backend/data/app.db

# 首启是否自动导入预编译 Wiki 快照 backend/data/wiki_seed.json
# NPU_AUTO_SEED=1
# NPU_WIKI_SEED_PATH=./backend/data/wiki_seed.json

# 上传大小上限（MB）
# NPU_MAX_UPLOAD_MB=20

# 移动端/公网运维：管理令牌（设置后管理操作需要 X-Admin-Token）
# 强烈建议公网访问时设置 24 位以上随机串；手机在「设置 → 管理令牌」登录
# 注意：绑定 0.0.0.0 对外监听但未设置令牌时，服务会拒绝启动（除非显式允许不安全内网演示）
# NPU_ADMIN_TOKEN=

# 跨域白名单（默认空 = 不开启 CORS；同源前端无需 CORS）
# NPU_CORS_ORIGINS=https://your-domain.example

# 仅可信内网临时演示时，允许对外监听但无令牌（默认 0，强烈不建议）
# NPU_ALLOW_INSECURE_LAN=0

# 手机扫码 / 公网访问（v0.1.1）
# 可选：固定公网地址（命名 Cloudflare Tunnel / Nginx 反代），二维码优先使用它
# NPU_PUBLIC_URL=https://npu.example.edu.cn
# cloudflared 可执行文件路径（不在 PATH 时设置）；用于「一键开启公网访问」
# NPU_CLOUDFLARED=./tools/cloudflared.exe
# 临时隧道启动超时秒数（默认 30）
# NPU_TUNNEL_TIMEOUT=30

# URL 快速收录（网页/公众号文章）
# NPU_URL_IMPORT_TIMEOUT=30
# 网页抓取大小上限（默认 8MB；微信/公众号文章常较大，可按需调大）
# NPU_URL_IMPORT_MAX_BYTES=8388608
# NPU_URL_IMPORT_MAX_URLS=5
# 内网资料才开启（默认禁止抓取私网/回环地址，防 SSRF）
# NPU_URL_IMPORT_ALLOW_PRIVATE=0

# 仅用于 scripts/build_wiki_seed.py 重新生成 Wiki 快照（不要提交到仓库）
# NPU_SEED_API_KEY=sk-...
# NPU_SEED_BASE_URL=https://api.deepseek.com/v1
# NPU_SEED_MODEL=deepseek-chat
