# NPU-Assistant 运行配置示例
# 复制为 .env 后按需注入；项目默认不自动加载 .env。

# 服务监听
# NPU_HOST=127.0.0.1
# NPU_PORT=8000

# 可选：管理接口令牌。设置后所有写操作需要请求头 X-Admin-Token
# NPU_ADMIN_TOKEN=

# 数据目录（默认 backend/data）
# NPU_DATA_DIR=D:\Development\NPU-Assistant\backend\data
# NPU_DB_PATH=D:\Development\NPU-Assistant\backend\data\app.db

# 首启是否自动导入预编译 Wiki 快照 backend/data/wiki_seed.json
# NPU_AUTO_SEED=1
# NPU_WIKI_SEED_PATH=D:\Development\NPU-Assistant\backend\data\wiki_seed.json

# 上传大小上限（MB）
# NPU_MAX_UPLOAD_MB=20

# 移动端/公网运维：管理令牌（设置后写操作需要 X-Admin-Token）
# 强烈建议公网访问时设置 24 位以上随机串；手机在「设置 → 管理令牌」登录
# NPU_ADMIN_TOKEN=

# URL 快速收录（网页/公众号文章）
# NPU_URL_IMPORT_TIMEOUT=30
# NPU_URL_IMPORT_MAX_BYTES=3145728
# NPU_URL_IMPORT_MAX_URLS=5
# 内网资料才开启（默认禁止抓取私网/回环地址，防 SSRF）
# NPU_URL_IMPORT_ALLOW_PRIVATE=0

# 仅用于 scripts/build_wiki_seed.py 重新生成 Wiki 快照（不要提交到仓库）
# NPU_SEED_API_KEY=sk-...
# NPU_SEED_BASE_URL=https://api.deepseek.com/v1
# NPU_SEED_MODEL=deepseek-chat
